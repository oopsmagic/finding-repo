PORT=5000

# Optional but recommended — raises GitHub API rate limits (60/hr unauthenticated → 5,000/hr)
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Max file/folder entries returned in the repository tree (default 300)
GITHUB_TREE_LIMIT=300

# Optional override (defaults to https://api.github.com)
# GITHUB_API_BASE_URL=https://api.github.com

# Required for AI repository analysis (OpenAI-compatible Chat Completions API)
AI_API_KEY=

# Optional AI provider overrides
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
